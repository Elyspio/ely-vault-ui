{
	"name": "elyvault",
	"version": "0.2.0",
	"private": true,
	"description": "Desktop client for a Vaultwarden / Bitwarden server, built on the official Bitwarden CLI",
	"homepage": "https://github.com/Elyspio/ely-vault-ui",
	"license": "MIT",
	"author": "jona.guich69@gmail.com",
	"repository": "github:Elyspio/ely-vault-ui",
	"main": "./out/main/index.js",
	"scripts": {
		"postinstall": "install-electron",
		"check": "vp check --fix",
		"test": "vp test",
		"test:live": "vp test --mode live",
		"typecheck": "tsc -b --noEmit",
		"dev": "electron-vite -c config/electron.vite.config.ts dev -w",
		"start": "electron-vite -c config/electron.vite.config.ts preview",
		"build": "electron-vite -c config/electron.vite.config.ts build",
		"package:win": "pnpm build && electron-builder --config config/electron-builder.yml --win",
		"package": "node scripts/release/release.ts package",
		"package:linux": "node scripts/release/release.ts package-linux",
		"release": "node scripts/release/release.ts",
		"release:dev": "node scripts/release/release.ts dev",
		"dev:vault:register": "node --env-file=scripts/dev/dev-vault.env scripts/dev/register-test-account.ts",
		"dev:vault:seed": "node --env-file=scripts/dev/dev-vault.env scripts/dev/seed-test-vault.ts"
	},
	"dependencies": {
		"@bitwarden/cli": "2026.9.1",
		"electron-updater": "^6.8.9",
		"jsqr": "^1.4.0",
		"koffi": "^3.3.2",
		"semver": "^7.8.5",
		"sshpk": "^1.18.0"
	},
	"devDependencies": {
		"@electron-toolkit/tsconfig": "^2.0.0",
		"@electron-toolkit/utils": "^4.0.0",
		"@elyspio/vite-eslint-config": "^8.0.0-rc.0",
		"@emotion/react": "^11.14.0",
		"@emotion/styled": "^11.14.1",
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@fontsource/ibm-plex-sans": "^5.3.0",
		"@mui/icons-material": "^9.5.0",
		"@mui/material": "^9.5.0",
		"@reduxjs/toolkit": "^2.13.0",
		"@types/node": "^26.6.5",
		"@types/qrcode": "^1.5.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/semver": "^7.8.0",
		"@types/sshpk": "^1.17.5",
		"@vitejs/plugin-react": "^6.1.2",
		"electron": "^44.7.0",
		"electron-builder": "^26.15.3",
		"electron-vite": "^6.0.0-beta.7",
		"inversify": "^8.2.3",
		"qrcode": "^1.5.4",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-redux": "^9.3.0",
		"reflect-metadata": "^0.2.2",
		"typescript": "^7.0.2",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"winston": "^3.19.0"
	},
	"engines": {
		"node": ">=26.0.0"
	},
	"packageManager": "pnpm@12.5.1"
}
